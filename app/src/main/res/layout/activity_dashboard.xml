<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header Card (Frosted Glass Navy) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@color/card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="@drawable/bg_glass_card">

                <!-- Full Width Greeting Line -->
                <TextView
                    android:id="@+id/tvWelcomeUser"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/welcome_admin"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_white"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <!-- Subtitle Line & Quick Actions -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/retail_shop_management_dashboard"
                        android:textSize="12sp"
                        android:textColor="@color/text_muted" />

                    <Button
                        android:id="@+id/btnSettings"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="⚙️ Settings"
                        android:textColor="@color/text_white"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="10dp"
                        android:backgroundTint="#253456"
                        android:layout_marginEnd="6dp"
                        app:cornerRadius="18dp" />

                    <Button
                        android:id="@+id/btnLogout"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="@string/logout"
                        android:textColor="@color/text_white"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="10dp"
                        android:backgroundTint="#253456"
                        app:cornerRadius="18dp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- KPI Grid Glass Cards -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="2"
            android:alignmentMode="alignMargins"
            android:columnOrderPreserved="false">

            <!-- Today's Sales Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/card_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@drawable/bg_kpi_sales">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/today_s_sales"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/blue_text" />

                    <TextView
                        android:id="@+id/tvTodaySales"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/_0_00"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Total Sales Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/card_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@drawable/bg_kpi_revenue">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/total_revenue"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/emerald_text" />

                    <TextView
                        android:id="@+id/tvTotalSales"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/_0_00_2nd"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Pending Payments Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/card_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@drawable/bg_kpi_pending">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pending_credits_2nd"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/warning_text" />

                    <TextView
                        android:id="@+id/tvPendingCredit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/_0_00_3rd"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/warning_accent"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Low Stock Warning Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/card_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@drawable/bg_kpi_lowstock">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/low_stock_items"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/amber_text" />

                    <TextView
                        android:id="@+id/tvLowStockCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/_0_items"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/amber_accent"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </GridLayout>

        <!-- Quick Actions Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/quick_actions"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="10dp" />

        <!-- Primary Action: New Bill -->
        <Button
            android:id="@+id/btnNewBilling"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="➕  CREATE NEW BILL / INVOICE"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/text_white"
            android:backgroundTint="@color/emerald"
            android:layout_marginBottom="12dp"
            app:cornerRadius="14dp" />

        <!-- Action Row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="10dp">

            <Button
                android:id="@+id/btnStockInventory"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:text="📦 Stock &amp; Inventory"
                android:textColor="@color/text_white"
                android:textSize="13sp"
                android:textStyle="bold"
                android:backgroundTint="#1D2842"
                app:cornerRadius="12dp" />

            <Button
                android:id="@+id/btnCustomers"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:text="👤 Customers Ledger"
                android:textColor="@color/text_white"
                android:textSize="13sp"
                android:textStyle="bold"
                android:backgroundTint="#1D2842"
                app:cornerRadius="12dp" />
        </LinearLayout>

        <!-- Action Row 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="20dp">

            <Button
                android:id="@+id/btnSalesHistory"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:text="📜 Bills &amp; History"
                android:textColor="@color/text_white"
                android:textSize="13sp"
                android:textStyle="bold"
                android:backgroundTint="#1D2842"
                app:cornerRadius="12dp" />

            <Button
                android:id="@+id/btnPaymentsCredit"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:text="💰 Pending Credits"
                android:textColor="@color/text_white"
                android:textSize="13sp"
                android:textStyle="bold"
                android:backgroundTint="#1D2842"
                app:cornerRadius="12dp" />
        </LinearLayout>

        <!-- Action Row 3: Stock Movement Log -->
        <Button
            android:id="@+id/btnStockMovement"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="📊  STOCK MOVEMENT &amp; INVENTORY LOG"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_white"
            android:backgroundTint="#253456"
            android:layout_marginBottom="20dp"
            app:cornerRadius="12dp" />

    </LinearLayout>
</ScrollView>
