<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/background">

    <!-- Top Billing Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <TextView
            android:id="@+id/tvCreateBillHeaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📑 New Invoice"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <Spinner
            android:id="@+id/spinnerCustomer"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:background="@drawable/bg_spinner"
            android:paddingHorizontal="8dp"
            android:spinnerMode="dropdown" />
    </LinearLayout>

    <!-- Optional Customer Mobile Number for Walk-in SMS Receipts -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Customer Mobile (for Instant SMS Receipt)"
        android:layout_marginBottom="10dp"
        app:hintTextColor="@color/accent"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etBillCustomerPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="phone"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Optional SMS Receipt CheckBox (Unchecked by Default) -->
    <CheckBox
        android:id="@+id/cbSendSms"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📱 Send SMS Receipt to Customer"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:checked="false"
        android:layout_marginBottom="10dp" />

    <!-- Instant Product Search Input Bar -->
    <AutoCompleteTextView
        android:id="@+id/actvSearchProduct"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="🔍 Type product name to search &amp; quick add..."
        android:textColorHint="@color/text_muted"
        android:textColor="@color/text_primary"
        android:paddingHorizontal="16dp"
        android:background="@drawable/bg_search_input"
        android:textSize="14sp"
        android:completionThreshold="1"
        android:layout_marginBottom="8dp" />

    <!-- Select Product Dropdown & Add Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <Spinner
            android:id="@+id/spinnerProduct"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_spinner"
            android:paddingHorizontal="8dp"
            android:spinnerMode="dropdown" />

        <Button
            android:id="@+id/btnAddToCart"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="➕ ADD ITEM"
            android:textColor="@color/text_white"
            android:textSize="13sp"
            android:textStyle="bold"
            android:backgroundTint="@color/accent"
            android:layout_marginStart="8dp"
            app:cornerRadius="12dp" />
    </LinearLayout>

    <!-- Cart RecyclerView Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cart Line Items"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="6dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCartItems"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layoutAnimation="@anim/layout_animation_fall_down"
        android:background="@drawable/bg_glass_card"
        android:padding="6dp" />

    <!-- Payment Summary Box -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="20dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="@color/card_bg"
        android:layout_marginTop="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/bg_glass_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Grand Total:"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/tvBillGrandTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹0.00"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/emerald_text" />
            </LinearLayout>

            <!-- Mode & Paid Amount Inputs -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mode: "
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <Spinner
                    android:id="@+id/spinnerPaymentMode"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_spinner"
                    android:paddingHorizontal="6dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="126dp"
                    android:layout_height="wrap_content"
                    android:hint="Paid (₹)"
                    android:layout_marginStart="8dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etBillPaidAmount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:text="0" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Due Balance (Added to Khata):"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:id="@+id/tvBillDueBalance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹0.00"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/warning_text" />
            </LinearLayout>

            <Button
                android:id="@+id/btnFinalizeBill"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="GENERATE BILL &amp; SEND SMS"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_white"
                android:backgroundTint="@color/emerald"
                android:layout_marginTop="14dp"
                app:cornerRadius="14dp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>
