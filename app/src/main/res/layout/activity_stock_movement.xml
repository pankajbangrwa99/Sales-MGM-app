<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/background">

    <!-- Top Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📦 Stock Movement &amp; Inventory Log"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="12dp" />

    <!-- KPI Summary Grid Cards -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:rowCount="1"
        android:alignmentMode="alignMargins"
        android:layout_marginBottom="12dp">

        <!-- Total Stock In Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_marginEnd="4dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp"
                android:background="@drawable/bg_kpi_revenue">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📈 Total Restocked / In"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/emerald_text" />

                <TextView
                    android:id="@+id/tvTotalStockIn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 Pcs"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Total Stock Out Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_marginStart="4dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp"
                android:background="@drawable/bg_kpi_sales">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📉 Total Sold / Out"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/blue_text" />

                <TextView
                    android:id="@+id/tvTotalStockOut"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 Pcs"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </GridLayout>

    <!-- Search Input -->
    <EditText
        android:id="@+id/etSearchStockLog"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Search log by product, invoice, customer..."
        android:textColorHint="@color/text_muted"
        android:textColor="@color/text_primary"
        android:paddingHorizontal="16dp"
        android:background="@drawable/bg_search_input"
        android:textSize="14sp"
        android:drawableStart="@android:drawable/ic_menu_search"
        android:drawablePadding="10dp"
        android:layout_marginBottom="10dp" />

    <!-- Filter Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/btnFilterAll"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:text="ALL"
            android:textColor="@color/text_white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:backgroundTint="@color/accent"
            android:layout_marginEnd="4dp"
            app:cornerRadius="10dp" />

        <Button
            android:id="@+id/btnFilterStockOut"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:text="📉 SOLD / OUT"
            android:textColor="@color/text_white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:backgroundTint="#1D2842"
            android:layout_marginHorizontal="2dp"
            app:cornerRadius="10dp" />

        <Button
            android:id="@+id/btnFilterStockIn"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:text="📈 IN / RESTOCK"
            android:textColor="@color/text_white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:backgroundTint="#1D2842"
            android:layout_marginStart="4dp"
            app:cornerRadius="10dp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvStockLogs"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layoutAnimation="@anim/layout_animation_fall_down" />

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/llEmptyState"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📊"
            android:textSize="64sp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No Stock Movements Logged"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Create billing invoices or restock inventory to generate stock movement logs"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:layout_marginTop="6dp" />
    </LinearLayout>

</LinearLayout>
