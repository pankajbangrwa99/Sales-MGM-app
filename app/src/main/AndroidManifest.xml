<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions required for local SIM SMS payment reminders and PDF invoice saving -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" 
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" 
        android:maxSdkVersion="32" />

    <application
        android:name=".SalesMgmApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SalesMgmApp"
        tools:targetApi="31">

        <!-- FileProvider for sharing PDF Invoices safely -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Login Activity (Launcher Entry Point) -->
        <activity
            android:name=".activities.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Register Activity for First-Time User Logins -->
        <activity
            android:name=".activities.RegisterActivity"
            android:exported="false"
            android:label="First-Time User Registration"
            android:windowSoftInputMode="adjustResize" />

        <!-- Dashboard Activity -->
        <activity
            android:name=".activities.DashboardActivity"
            android:exported="false"
            android:label="Dashboard" />

        <!-- Inventory / Product Activities -->
        <activity
            android:name=".activities.ProductListActivity"
            android:exported="false"
            android:label="Stock &amp; Inventory" />
        <activity
            android:name=".activities.AddEditProductActivity"
            android:exported="false"
            android:label="Product Details" />

        <!-- Stock Movement Activities -->
        <activity
            android:name=".activities.StockMovementActivity"
            android:exported="false"
            android:label="Stock Movement Log" />
        <activity
            android:name=".activities.StockLogDetailActivity"
            android:exported="false"
            android:label="Sold &amp; Movement Details" />

        <!-- Customer Activities -->
        <activity
            android:name=".activities.CustomerListActivity"
            android:exported="false"
            android:label="Customers" />
        <activity
            android:name=".activities.AddEditCustomerActivity"
            android:exported="false"
            android:label="Customer Entry" />
        <activity
            android:name=".activities.CustomerDetailActivity"
            android:exported="false"
            android:label="Customer Profile" />

        <!-- Billing Activities -->
        <activity
            android:name=".activities.CreateBillActivity"
            android:exported="false"
            android:label="New Billing" />
        <activity
            android:name=".activities.BillHistoryActivity"
            android:exported="false"
            android:label="Sales &amp; Bills History" />
        <activity
            android:name=".activities.BillDetailActivity"
            android:exported="false"
            android:label="Invoice Details" />

        <!-- Payment Activities -->
        <activity
            android:name=".activities.PaymentListActivity"
            android:exported="false"
            android:label="Pending Payments &amp; Credits" />
        <activity
            android:name=".activities.AddPaymentActivity"
            android:exported="false"
            android:label="Record Payment" />

        <!-- Settings Activity -->
        <activity
            android:name=".activities.ShopSettingsActivity"
            android:exported="false"
            android:label="Shop &amp; Account Settings" />

    </application>

</manifest>
